# Local development example. Copy to .env; .env is ignored by Git.
APP_NAME=CloudLab Edu
APP_ENV=development
APP_VERSION=1.3.0
APP_SECRET=change-this-long-random-secret
DATABASE_URL=sqlite:///./practicum.db
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
FRONTEND_DIR=../frontend
SIMULATE_HEALTH_FAILURE=false
ENABLE_FAILURE_DEMO=false
DEMO_ADMIN_PASSWORD=change-admin-password
DEMO_DOSEN_PASSWORD=change-dosen-password
DEMO_MAHASISWA_PASSWORD=change-mahasiswa-password
